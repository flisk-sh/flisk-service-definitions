{
  "$id": "https://tdk-landscape.github.io/schema.app.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TDK App Registration",
  "description": "One app in the registry. Its services/ directory holds one service.json per TDK resource.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "schemaVersion"],
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "description": "Scoped app name, must equal @<owner>/<app> from the directory path.",
      "type": "string",
      "pattern": "^@[a-z0-9][a-z0-9-]{1,38}/[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$"
    },
    "schemaVersion": { "const": 1, "type": "integer" },
    "description": { "type": "string", "maxLength": 280 },
    "homepage": { "type": "string", "pattern": "^https://" },
    "repository": { "type": "string", "pattern": "^https://" },
    "license": { "type": "string" }
  }
}
