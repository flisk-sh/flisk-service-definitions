{
  "$schema": "https://tdk-landscape.github.io/schema.service.json",
  "schemaVersion": 1,
  "appName": "php-fpm-mailcow",
  "appType": "bring-your-own",
  "stack": "mailcow-dockerized",
  "port": 4010,
  "image": "ghcr.io/mailcow/phpfpm:8.2.29-3",
  "dependsOn": [
    "redis-mailcow"
  ],
  "dev": {
    "command": "php-fpm -d date.timezone=${TZ} -d expose_php=0"
  }
}
