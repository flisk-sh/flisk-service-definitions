{
  "$schema": "https://tdk-landscape.github.io/schema.service.json",
  "schemaVersion": 1,
  "appName": "traefik",
  "appType": "bring-your-own",
  "stack": "laradock",
  "port": 4110,
  "dockerfile": "./Dockerfile",
  "dev": {
    "command": "--api --providers.docker.exposedbydefault=false --accesslog.filepath=/data/access.log --entrypoints.http.address=:${TRAEFIK_HOST_HTTP_PORT} --entrypoints.http.http.redirections.entrypoint.to=https --entrypoints.https.address=:${TRAEFIK_HOST_HTTPS_PORT} --entrypoints.traefik.address=:${TRAEFIK_DASHBOARD_PORT} --certificatesresolvers.letsencrypt.acme.email=${ACME_EMAIL} --certificatesresolvers.letsencrypt.acme.storage=/data/acme.json --certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=http"
  },
  "healthCheckPath": "/"
}
