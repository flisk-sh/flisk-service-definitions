{
  "$schema": "https://tdk-landscape.github.io/schema.service.json",
  "schemaVersion": 1,
  "appName": "prometheus",
  "appType": "bring-your-own",
  "stack": "cdn-up-and-running",
  "port": 4002,
  "image": "prom/prometheus:v2.17.1",
  "dev": {
    "command": "--config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/prometheus --web.console.libraries=/etc/prometheus/console_libraries --web.console.templates=/etc/prometheus/consoles --storage.tsdb.retention.time=24h --web.enable-lifecycle"
  },
  "healthCheckPath": "/"
}
